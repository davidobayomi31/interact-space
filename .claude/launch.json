{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "interact-space",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 5173
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "API_PORT=8788 npx concurrently -n api,web \"node server/index.js\" \"vite --port 5174 --strictPort\""
      ],
      "port": 5174,
      "autoPort": false
    }
  ]
}