# ── Interact Space — server environment ──────────────────────────────
# Copy this file to ".env" and fill in values.

# REQUIRED. Postgres connection string. The server will not start without it.
#
#   Local development, using the Postgres you run yourself:
#     DATABASE_URL=postgres://postgres@127.0.0.1:5432/interact
#
#   Production: create a free database at https://neon.tech and paste the
#   connection string it gives you. Set the same value in the Vercel
#   dashboard under Settings → Environment Variables.
DATABASE_URL=

# Secret used to sign login sessions. Set a long random string in production
# (Vercel: Settings → Environment Variables). Defaults to a dev value if unset,
# which is fine locally and NOT fine in production.
# JWT_SECRET=

# Enable the real LLM companion. Get a key at https://console.anthropic.com
# Without it the companion falls back to the rule-based engine and still works.
ANTHROPIC_API_KEY=

# Optional: which Claude model the companion uses (default: claude-sonnet-5)
# COMPANION_MODEL=claude-sonnet-5

# Optional: port for the API server locally (default: 8787). The web app
# proxies /api to this port (see vite.config.js). Unused on Vercel.
# API_PORT=8787

# Optional escape hatch: set to 1 only if your Postgres host's TLS certificate
# can't be verified by Node. Keeps traffic encrypted but stops checking who is
# on the other end.
# PGSSL_NO_VERIFY=1
