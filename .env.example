# ── VOIDAJ — server environment ──────────────────────────────
# Copy this file to ".env" and fill in values.

# REQUIRED. Postgres connection string. The server will not start without it.
#
#   Local development, using the Postgres you run yourself:
#     DATABASE_URL=postgres://postgres@127.0.0.1:5432/voidaj
#
#   Production: create a free database at https://neon.tech and paste the
#   connection string it gives you. Set the same value in the Vercel
#   dashboard under Settings → Environment Variables.
DATABASE_URL=

# Secret used to sign login sessions. Set a long random string in production
# (Vercel: Settings → Environment Variables). Defaults to a dev value if unset,
# which is fine locally and NOT fine in production.
# JWT_SECRET=

# Enable the real LLM companion. Get a key at https://console.anthropic.com
# Without it the companion falls back to the rule-based engine and still works.
ANTHROPIC_API_KEY=

# Optional: which Claude model the companion uses (default: claude-sonnet-5)
# COMPANION_MODEL=claude-sonnet-5

# Optional: port for the API server locally (default: 8787). The web app
# proxies /api to this port (see vite.config.js). Unused on Vercel.
# API_PORT=8787

# Optional escape hatch: set to 1 only if your Postgres host's TLS certificate
# can't be verified by Node. Keeps traffic encrypted but stops checking who is
# on the other end.
# PGSSL_NO_VERIFY=1

# Cover photos for communities and events (Supabase Storage). In the
# Supabase dashboard: Storage → New bucket → name it "covers" and tick
# "Public bucket". Then Project Settings → API: copy the Project URL and the
# service_role key here, and into Vercel's Environment Variables. The
# service key is a secret — never put it in frontend code.
# Without these, uploads still work locally (photos are kept inline in the
# database) but are switched off on Vercel.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=covers

# Sign in with Google and Apple. Each button switches on once its keys are
# set here and in Vercel. Without them the buttons say "Not set up yet".
# PUBLIC_URL is the site's address, used to build the callback links
# (e.g. https://voidaj.com). Locally it can stay unset.
# PUBLIC_URL=https://voidaj.com
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID (Web application). Authorised redirect URIs:
#   https://voidaj.com/api/auth/google/callback
#   http://localhost:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Apple (needs a paid Apple Developer account): developer.apple.com →
# Identifiers → a Services ID with "Sign in with Apple", return URL
#   https://voidaj.com/api/auth/apple/callback
# (Apple only allows https, so it can't be tried on plain localhost).
# Then Keys → a key with Sign in with Apple; download the .p8 file.
# APPLE_CLIENT_ID=com.voidaj.web          # the Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
