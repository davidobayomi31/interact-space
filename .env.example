# ── Interact Space — server environment ──────────────────────────────
# Copy this file to ".env" and fill in values. The app runs fine WITHOUT
# any of these set (the companion falls back to the rule-based engine).

# Enable the real LLM companion. Get a key at https://console.anthropic.com
# When this is set, the AI companion uses Claude instead of keyword matching.
ANTHROPIC_API_KEY=

# Optional: which Claude model the companion uses (default: claude-sonnet-5)
# COMPANION_MODEL=claude-sonnet-5

# Optional: secret used to sign login sessions. Set a long random string in
# production. Defaults to a dev value if unset.
# JWT_SECRET=

# Optional: port for the API server (default: 8787). The web app proxies
# /api to this port (see vite.config.js).
# API_PORT=8787
